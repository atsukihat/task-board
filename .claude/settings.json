{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test:run)",
      "Bash(npm run build)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(git push *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(sudo *)",
      "Bash(git push --force *)"
    ]
  }
}
